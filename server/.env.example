# Database connection (MongoDB Atlas or local MongoDB)
# Replace with your connection string from MongoDB Atlas:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a 64+ char random string for production)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Server Port
PORT=5000

# Client Web Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node Environment ('development', 'production', 'test')
NODE_ENV=development

