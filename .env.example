# PulseClass Environment Configuration Template
# Copy this file to `server/.env` and update the values before starting the backend.

# MongoDB Connection String (MongoDB Atlas or Local)
# DO NOT commit the file containing real credentials!
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random 32+ character string in production)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Server Port
PORT=5000

# Client Web Application URL (for CORS and Socket.io)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
